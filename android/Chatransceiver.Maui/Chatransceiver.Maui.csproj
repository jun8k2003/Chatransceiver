<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Chatransceiver.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Display name & identifiers -->
    <ApplicationTitle>Chatransceiver</ApplicationTitle>
    <ApplicationId>com.chatransceiver.app</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
    <!-- ローカル環境に android-35 SDK が無く android-36 / android-34 がある場合の自動フォールバック -->
    <_AndroidApiLevel Condition="!Exists('C:\Program Files (x86)\Android\android-sdk\platforms\android-35\android.jar') and Exists('C:\Program Files (x86)\Android\android-sdk\platforms\android-36\android.jar')">36</_AndroidApiLevel>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon & Images -->
    <MauiIcon Include="Resources\AppIcon\appicon.png" />
    <MauiSplashScreen Include="Resources\AppIcon\appicon.png" Color="#0F172A" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="Exists('google-services.json')">
    <GoogleServicesJson Include="google-services.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.50" />
    <PackageReference Include="Xamarin.Firebase.Messaging" Version="124.0.0.2" />
    <PackageReference Include="Xamarin.GooglePlayServices.Base" Version="118.5.0.2" />
  </ItemGroup>

  <!-- ローカルの .env が存在し AppConfig.Defaults.cs が未生成の場合、VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY を自動注入 -->
  <Target Name="GenerateSupabaseDefaultsFromDotEnv" BeforeTargets="CoreCompile" Condition="!Exists('Services\AppConfig.Defaults.cs') and Exists('..\..\.env')">
    <PropertyGroup>
      <_DotEnvContent>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\..\.env'))</_DotEnvContent>
      <_SupabaseUrl>$([System.Text.RegularExpressions.Regex]::Match($(_DotEnvContent), '(?m)^VITE_SUPABASE_URL=(.+)$').Groups[1].Value.Trim())</_SupabaseUrl>
      <_SupabaseAnonKey>$([System.Text.RegularExpressions.Regex]::Match($(_DotEnvContent), '(?m)^VITE_SUPABASE_ANON_KEY=(.+)$').Groups[1].Value.Trim())</_SupabaseAnonKey>
      <_DefaultsCode>namespace Chatransceiver.Maui.Services%3B
public static partial class AppConfig
{
    static partial void LoadBuildDefaults(ref string url, ref string anonKey)
    {
        url = "$(_SupabaseUrl)"%3B
        anonKey = "$(_SupabaseAnonKey)"%3B
    }
}
</_DefaultsCode>
    </PropertyGroup>
    <WriteLinesToFile File="Services\AppConfig.Defaults.cs" Lines="$(_DefaultsCode)" Overwrite="true" Condition="'$(_SupabaseUrl)' != ''" />
    <ItemGroup Condition="Exists('Services\AppConfig.Defaults.cs')">
      <Compile Include="Services\AppConfig.Defaults.cs" Exclude="@(Compile)" />
    </ItemGroup>
  </Target>

</Project>

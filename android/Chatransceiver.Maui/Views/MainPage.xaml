<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Chatransceiver.Maui.Models"
             x:Class="Chatransceiver.Maui.Views.MainPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Dark={StaticResource DarkBgPrimary}, Light={StaticResource LightBgPrimary}}">

    <Grid>
        <!-- ==================== メイン画面レイアウト ==================== -->
        <Grid RowDefinitions="Auto,Auto,*">

            <!-- 1. 最上部ヘッダー (DEC-024 / DEC-034 / DEC-035) -->
            <VerticalStackLayout Grid.Row="0"
                                 BackgroundColor="{AppThemeBinding Dark={StaticResource DarkBgSecondary}, Light={StaticResource LightBgSecondary}}">
                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="8"
                      Padding="10,8">
                    <!-- ロゴ -->
                    <Image Grid.Column="0"
                           Source="chatora.png"
                           WidthRequest="30"
                           HeightRequest="30"
                           VerticalOptions="Center" />

                    <!-- コミュニティ名ピル (タップでドロップダウン開閉) -->
                    <Button x:Name="CommunityPillButton"
                            Grid.Column="1"
                            Text="🌐 未接続 (タップで接続)"
                            FontSize="13"
                            FontAttributes="Bold"
                            HeightRequest="36"
                            MinimumHeightRequest="0"
                            CornerRadius="18"
                            Padding="12,0"
                            BackgroundColor="{AppThemeBinding Dark={StaticResource DarkBgCard}, Light={StaticResource LightBgCard}}"
                            TextColor="{AppThemeBinding Dark={StaticResource DarkTextPrimary}, Light={StaticResource LightTextPrimary}}"
                            Clicked="OnCommunityPillClicked" />

                    <!-- 右側操作アイコン群 (🔔 FCM / 🎧 イヤフォンPTT / ⚙️ 設定) -->
                    <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                        <Button x:Name="FcmToggleButton"
                                Text="🔔"
                                FontSize="15"
                                WidthRequest="38"
                                HeightRequest="36"
                                MinimumWidthRequest="0"
                                MinimumHeightRequest="0"
                                Padding="0"
                                CornerRadius="8"
                                BackgroundColor="{AppThemeBinding Dark={StaticResource DarkBgCard}, Light={StaticResource LightBgCard}}"
                                Clicked="OnFcmToggleClicked" />

                        <Button x:Name="HeadsetPttButton"
                                Text="🎧"
                                FontSize="15"
                                WidthRequest="38"
                                HeightRequest="36"
                                MinimumWidthRequest="0"
                                MinimumHeightRequest="0"
                                Padding="0"
                                CornerRadius="8"
                                BackgroundColor="{AppThemeBinding Dark={StaticResource DarkBgCard}, Light={StaticResource LightBgCard}}"
                                Clicked="OnHeadsetPttToggleClicked" />

                        <Button Text="⚙️"
                                FontSize="15"
                                WidthRequest="38"
                                HeightRequest="36"
                                MinimumWidthRequest="0"
                                MinimumHeightRequest="0"
                                Padding="0"
                                CornerRadius="8"
                                BackgroundColor="{AppThemeBinding Dark={StaticResource DarkBgCard}, Light={StaticResource LightBgCard}}"
                                Clicked="OnSettingsClicked" />
                    </HorizontalStackLayout>
                </Grid>
                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding Dark={StaticResource DarkBorder}, Light={StaticResource LightBorder}}" />
            </VerticalStackLayout>

            <!-- 2. モバイル画面切替タブ (リスト ⇄ チャット) -->
            <Grid Grid.Row="1"
                  ColumnDefinitions="*,*"
                  Padding="10,6"
                  ColumnSpacing="8"
                  BackgroundColor="{AppThemeBinding Dark={StaticResource DarkBgSecondary}, Light={StaticResource LightBgSecondary}}">
                <Button x:Name="TabListButton"
                        Grid.Column="0"
                        Text="👥 メンバー・グループ"
                        FontSize="13"
                        FontAttributes="Bold"
                        HeightRequest="36"
                        MinimumHeightRequest="0"
                        Padding="6,0"
                        CornerRadius="8"
                        BackgroundColor="{StaticResource PrimaryBlue}"
                        TextColor="White"
                        Clicked="OnShowListPaneClicked" />
                <Button x:Name="TabChatButton"
                        Grid.Column="1"
                        Text="💬 チャット・PTT発話"
                        FontSize="13"
                        FontAttributes="Bold"
                        HeightRequest="36"
                        MinimumHeightRequest="0"
                        Padding="6,0"
                        CornerRadius="8"
                        BackgroundColor="{AppThemeBinding Dark={StaticResource DarkBgCard}, Light={StaticResource LightBgCard}}"
                        TextColor="{AppThemeBinding Dark={StaticResource DarkTextPrimary}, Light={StaticResource LightTextPrimary}}"
                        Clicked="OnShowChatPaneClicked" />
            </Grid>

            <!-- 3. コンテンツ領域 (統合リストペイン & チャットペイン) -->
            <Grid Grid.Row="2">

                <!-- ========== A. 統合リストペイン (DEC-024) ========== -->
                <Grid x:Name="ListPaneGrid"
                      RowDefinitions="Auto,Auto,*"
                      Padding="10"
                      RowSpacing="8">

                    <!-- フィルタチップ (すべて / 個別 / グループ) + 新規グループボタン -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="6">
                        <Button x:Name="FilterAllBtn"
                                Grid.Column="0"
                                Text="すべて"
                                FontSize="12"
                                HeightRequest="32"
                                MinimumWidthRequest="0"
                                MinimumHeightRequest="0"
                                Padding="12,0"
                                CornerRadius="16"
                                BackgroundColor="{StaticResource PrimaryBlue}"
                                TextColor="White"
                                Clicked="OnFilterAllClicked" />
                        <Button x:Name="FilterIndividualBtn"
                                Grid.Column="1"
                                Text="個別"
                                FontSize="12"
                                HeightRequest="32"
                                MinimumWidthRequest="0"
                                MinimumHeightRequest="0"
                                Padding="12,0"
                                CornerRadius="16"
                                BackgroundColor="{AppThemeBinding Dark={StaticResource DarkBgCard}, Light={StaticResource LightBgCard}}"
                                TextColor="{AppThemeBinding Dark={StaticResource DarkTextPrimary}, Light={StaticResource LightTextPrimary}}"
                                Clicked="OnFilterIndividualClicked" />
                        <Button x:Name="FilterGroupBtn"
                                Grid.Column="2"
                                Text="グループ"
                                FontSize="12"
                                HeightRequest="32"
                                MinimumWidthRequest="0"
                                MinimumHeightRequest="0"
                                Padding="12,0"
                                CornerRadius="16"
                                BackgroundColor="{AppThemeBinding Dark={StaticResource DarkBgCard}, Light={StaticResource LightBgCard}}"
                                TextColor="{AppThemeBinding Dark={StaticResource DarkTextPrimary}, Light={StaticResource LightTextPrimary}}"
                                Clicked="OnFilterGroupClicked" />

                        <Button x:Name="NewGroupModeBtn"
                                Grid.Column="4"
                                Text="＋新規グループ"
                                FontSize="12"
                                HeightRequest="32"
                                MinimumWidthRequest="0"
                                MinimumHeightRequest="0"
                                Padding="12,0"
                                CornerRadius="16"
                                BackgroundColor="{AppThemeBinding Dark={StaticResource DarkBgCard}, Light={StaticResource LightBgCard}}"
                                TextColor="{AppThemeBinding Dark={StaticResource DarkTextPrimary}, Light={StaticResource LightTextPrimary}}"
                                Clicked="OnToggleGroupSelectModeClicked" />
                    </Grid>

                    <!-- 新規グループ複数選択モード時の確定バー -->
                    <Border x:Name="GroupCreateConfirmBar"
                            Grid.Row="1"
                            IsVisible="False"
                            BackgroundColor="{AppThemeBinding Dark={StaticResource DarkBgSecondary}, Light={StaticResource LightBgSecondary}}"
                            Stroke="{StaticResource PrimaryBlue}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="10">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <Label Text="メンバー(2人以上)をタップして選択"
                                   FontSize="12"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Dark={StaticResource DarkTextPrimary}, Light={StaticResource LightTextPrimary}}" />
                            <Button Grid.Column="1"
                                    Text="作成"
                                    FontSize="12"
                                    HeightRequest="34"
                                    MinimumWidthRequest="0"
                                    MinimumHeightRequest="0"
                                    Padding="12,0"
                                    BackgroundColor="{StaticResource PrimaryBlue}"
                                    TextColor="White"
                                    Clicked="OnConfirmCreateGroupClicked" />
                            <Button Grid.Column="2"
                                    Text="キャンセル"
                                    FontSize="12"
                                    HeightRequest="34"
                                    MinimumWidthRequest="0"
                                    MinimumHeightRequest="0"
                                    Padding="8,0"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Dark={StaticResource DarkTextSecondary}, Light={StaticResource LightTextSecondary}}"
                                    Clicked="OnToggleGroupSelectModeClicked" />
                        </Grid>
                    </Border>

                    <!-- 統合リスト本体 -->
                    <CollectionView x:Name="UnifiedCollectionView"
                                    Grid.Row="2"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8" Padding="24">
                                <Label Text="メンバーまたはグループがありません"
                                       HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Dark={StaticResource DarkTextSecondary}, Light={StaticResource LightTextSecondary}}" />
                                <Label Text="上部のコミュニティピルからコミュニティに接続してください"
                                       FontSize="12"
                                       HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Dark={StaticResource DarkTextSecondary}, Light={StaticResource LightTextSecondary}}" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:UnifiedListItem">
                                <Border Margin="0,3"
                                        Padding="12,10"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 10"
                                        BackgroundColor="{AppThemeBinding Dark={StaticResource DarkBgSecondary}, Light={StaticResource LightBgSecondary}}"
                                        Stroke="{AppThemeBinding Dark={StaticResource DarkBorder}, Light={StaticResource LightBorder}}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnUnifiedItemTapped" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                        <!-- オンライン状態ドット -->
                                        <BoxView Grid.Column="0"
                                                 WidthRequest="10"
                                                 HeightRequest="10"
                                                 CornerRadius="5"
                                                 VerticalOptions="Center"
                                                 Color="{StaticResource OnlineGreen}"
                                                 IsVisible="{Binding IsOnline}" />

                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding DisplayTitle}"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Dark={StaticResource DarkTextPrimary}, Light={StaticResource LightTextPrimary}}" />
                                            <Label Text="{Binding Subtitle}"
                                                   FontSize="11"
                                                   TextColor="{AppThemeBinding Dark={StaticResource DarkTextSecondary}, Light={StaticResource LightTextSecondary}}" />
                                        </VerticalStackLayout>

                                        <!-- グループ選択中マーク -->
                                        <Label Grid.Column="2"
                                               Text="☑️"
                                               FontSize="18"
                                               VerticalOptions="Center"
                                               IsVisible="{Binding IsSelectedForGroup}" />

                                        <!-- 未読バッジ -->
                                        <Border Grid.Column="3"
                                                IsVisible="{Binding HasUnread}"
                                                StrokeThickness="0"
                                                BackgroundColor="{StaticResource AccentOrange}"
                                                StrokeShape="RoundRectangle 12"
                                                Padding="8,2"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding UnreadBadgeText}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="White" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>

                <!-- ========== B. チャット＆PTTペイン ========== -->
                <Grid x:Name="ChatPaneGrid"
                      IsVisible="False"
                      RowDefinitions="Auto,*,Auto">

                    <!-- チャットルームヘッダー (グループ名編集✏️ & 履歴削除🗑️) -->
                    <VerticalStackLayout Grid.Row="0"
                                         BackgroundColor="{AppThemeBinding Dark={StaticResource DarkBgSecondary}, Light={StaticResource LightBgSecondary}}">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Padding="12,8">
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                <Label x:Name="ChatHeaderTitleLabel"
                                       Text="チャット未選択"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Dark={StaticResource DarkTextPrimary}, Light={StaticResource LightTextPrimary}}" />
                                <Label x:Name="ChatHeaderSubtitleLabel"
                                       Text="一覧から送信先を選択してください"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Dark={StaticResource DarkTextSecondary}, Light={StaticResource LightTextSecondary}}" />
                            </VerticalStackLayout>

                            <Button x:Name="EditGroupNameButton"
                                    Grid.Column="1"
                                    IsVisible="False"
                                    Text="✏️"
                                    WidthRequest="38"
                                    HeightRequest="34"
                                    MinimumWidthRequest="0"
                                    MinimumHeightRequest="0"
                                    Padding="0"
                                    CornerRadius="8"
                                    BackgroundColor="{AppThemeBinding Dark={StaticResource DarkBgCard}, Light={StaticResource LightBgCard}}"
                                    Clicked="OnEditGroupNameClicked" />

                            <Button x:Name="ClearRoomButton"
                                    Grid.Column="2"
                                    IsVisible="False"
                                    Text="🗑️"
                                    WidthRequest="38"
                                    HeightRequest="34"
                                    MinimumWidthRequest="0"
                                    MinimumHeightRequest="0"
                                    Padding="0"
                                    CornerRadius="8"
                                    BackgroundColor="{AppThemeBinding Dark={StaticResource DarkBgCard}, Light={StaticResource LightBgCard}}"
                                    Clicked="OnClearRoomClicked" />
                        </Grid>
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Dark={StaticResource DarkBorder}, Light={StaticResource LightBorder}}" />
                    </VerticalStackLayout>

                    <!-- メッセージ履歴タイムライン -->
                    <CollectionView x:Name="MessagesCollectionView"
                                    Grid.Row="1"
                                    Margin="10,6"
                                    ItemsUpdatingScrollMode="KeepLastItemInView"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="24">
                                <Label Text="まだメッセージはありません。下の「🎙️ TALK」ボタンまたはテキスト入力から送信できます。"
                                       FontSize="13"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Dark={StaticResource DarkTextSecondary}, Light={StaticResource LightTextSecondary}}" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:SupabaseMessage">
                                <Grid>
                                    <Border HorizontalOptions="{Binding BubbleHorizontalOptions}"
                                            Margin="{Binding BubbleMargin}"
                                            Padding="12,8"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 12"
                                            BackgroundColor="{AppThemeBinding Dark={StaticResource DarkBgSecondary}, Light={StaticResource LightBgSecondary}}"
                                            Stroke="{AppThemeBinding Dark={StaticResource DarkBorder}, Light={StaticResource LightBorder}}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsMine}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Dark=#1E3A5F, Light=#DBEAFE}" />
                                                <Setter Property="Stroke" Value="{AppThemeBinding Dark=#2563EB, Light=#93C5FD}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <VerticalStackLayout Spacing="6" MinimumWidthRequest="150">
                                            <HorizontalStackLayout Spacing="10">
                                                <Label Text="{Binding SenderName}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource PrimaryBlue}" />
                                                <Label Text="{Binding TimeText}"
                                                       FontSize="11"
                                                       VerticalOptions="Center"
                                                       TextColor="{AppThemeBinding Dark={StaticResource DarkTextSecondary}, Light={StaticResource LightTextSecondary}}" />
                                            </HorizontalStackLayout>

                                            <Label Text="{Binding DisplayText}"
                                                   FontSize="14"
                                                   TextColor="{AppThemeBinding Dark={StaticResource DarkTextPrimary}, Light={StaticResource LightTextPrimary}}" />

                                            <HorizontalStackLayout Spacing="8">
                                                <Button Text="{Binding PlayButtonLabel}"
                                                        IsVisible="{Binding CanPlay}"
                                                        FontSize="12"
                                                        HeightRequest="32"
                                                        MinimumWidthRequest="0"
                                                        MinimumHeightRequest="0"
                                                        Padding="12,0"
                                                        CornerRadius="6"
                                                        BackgroundColor="{AppThemeBinding Dark={StaticResource DarkBgCard}, Light={StaticResource LightBgCard}}"
                                                        TextColor="{AppThemeBinding Dark={StaticResource DarkTextPrimary}, Light={StaticResource LightTextPrimary}}"
                                                        CommandParameter="{Binding .}"
                                                        Clicked="OnPlayMessageBubbleClicked" />

                                                <Button Text="🗑️ 取り消し"
                                                        IsVisible="{Binding CanRevoke}"
                                                        FontSize="12"
                                                        HeightRequest="32"
                                                        MinimumWidthRequest="0"
                                                        MinimumHeightRequest="0"
                                                        Padding="10,0"
                                                        CornerRadius="6"
                                                        BackgroundColor="Transparent"
                                                        TextColor="{StaticResource DangerRed}"
                                                        CommandParameter="{Binding .}"
                                                        Clicked="OnRevokeMessageClicked" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- 下部 PTT & テキスト送信フッター (Web版 chat-footer 準拠 DEC-024) -->
                    <VerticalStackLayout Grid.Row="2"
                                         BackgroundColor="{AppThemeBinding Dark={StaticResource DarkBgSecondary}, Light={StaticResource LightBgSecondary}}">
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Dark={StaticResource DarkBorder}, Light={StaticResource LightBorder}}" />

                        <VerticalStackLayout Padding="14,10" Spacing="10">
                            <!-- 中央の大型円形/ピル型 TALK ボタン (主役) -->
                            <Button x:Name="PttMainButton"
                                    Text="🎙️ TALK（タップして録音開始）"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    HeightRequest="54"
                                    CornerRadius="27"
                                    BackgroundColor="{StaticResource AccentOrange}"
                                    TextColor="White"
                                    Clicked="OnPttMainButtonClicked" />

                            <!-- テキスト入力 & 送信バー -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Border Grid.Column="0"
                                        Stroke="{AppThemeBinding Dark={StaticResource DarkBorder}, Light={StaticResource LightBorder}}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="{AppThemeBinding Dark={StaticResource DarkBgPrimary}, Light={StaticResource LightBgPrimary}}"
                                        Padding="10,2">
                                    <Entry x:Name="TextMessageEntry"
                                           Placeholder="メッセージを入力... (受信側はTTS読み上げ)"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Dark={StaticResource DarkTextPrimary}, Light={StaticResource LightTextPrimary}}"
                                           PlaceholderColor="{AppThemeBinding Dark={StaticResource DarkTextSecondary}, Light={StaticResource LightTextSecondary}}"
                                           Completed="OnSendTextClicked" />
                                </Border>
                                <Button Grid.Column="1"
                                        Text="➤ 送信"
                                        BackgroundColor="{StaticResource PrimaryBlue}"
                                        TextColor="White"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        HeightRequest="44"
                                        MinimumWidthRequest="0"
                                        MinimumHeightRequest="0"
                                        Padding="16,0"
                                        CornerRadius="8"
                                        Clicked="OnSendTextClicked" />
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Grid>
        </Grid>

        <!-- ==================== 録音モーダルダイアログ (Web版 recordingModal 準拠) ==================== -->
        <Grid x:Name="RecordingModalOverlay"
              IsVisible="False"
              BackgroundColor="#CC000000"
              Padding="20">
            <Border VerticalOptions="Center"
                    BackgroundColor="{AppThemeBinding Dark={StaticResource DarkBgSecondary}, Light={StaticResource LightBgSecondary}}"
                    Stroke="{StaticResource AccentOrange}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 16"
                    Padding="20">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="RecordingStatusTitleLabel"
                               Text="🔴 音声録音中..."
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource AccentOrange}"
                               VerticalOptions="Center" />
                        <Label x:Name="RecordingTimerLabel"
                               Grid.Column="1"
                               Text="00:15"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Dark={StaticResource DarkTextPrimary}, Light={StaticResource LightTextPrimary}}"
                               VerticalOptions="Center" />
                    </Grid>

                    <ProgressBar x:Name="RecordingProgressBar"
                                 Progress="1.0"
                                 ProgressColor="{StaticResource AccentOrange}" />

                    <Label Text="話しかけてください（最大15秒）"
                           FontSize="13"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Dark={StaticResource DarkTextSecondary}, Light={StaticResource LightTextSecondary}}" />

                    <!-- 文字起こしプレビュー枠 -->
                    <Border Stroke="{AppThemeBinding Dark={StaticResource DarkBorder}, Light={StaticResource LightBorder}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="{AppThemeBinding Dark={StaticResource DarkBgPrimary}, Light={StaticResource LightBgPrimary}}"
                            MinimumHeightRequest="64"
                            Padding="12">
                        <Label x:Name="TranscriptPreviewLabel"
                               Text="（発話すると文字起こしが表示されます）"
                               FontSize="14"
                               TextColor="{AppThemeBinding Dark={StaticResource DarkTextPrimary}, Light={StaticResource LightTextPrimary}}" />
                    </Border>

                    <!-- アクションボタン (今すぐ送信 / 停止して確認 / キャンセル) -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button x:Name="ModalStopBtn"
                                Grid.Column="0"
                                Text="⏹️ 停止して確認"
                                FontSize="14"
                                FontAttributes="Bold"
                                HeightRequest="46"
                                CornerRadius="10"
                                BackgroundColor="{AppThemeBinding Dark={StaticResource DarkBgCard}, Light={StaticResource LightBgCard}}"
                                TextColor="{AppThemeBinding Dark={StaticResource DarkTextPrimary}, Light={StaticResource LightTextPrimary}}"
                                Clicked="OnModalStopRecordingClicked" />

                        <Button x:Name="ModalSendBtn"
                                Grid.Column="1"
                                Text="📤 送信する"
                                FontSize="14"
                                FontAttributes="Bold"
                                HeightRequest="46"
                                CornerRadius="10"
                                BackgroundColor="{StaticResource PrimaryBlue}"
                                TextColor="White"
                                Clicked="OnModalSendRecordingClicked" />
                    </Grid>

                    <Button Text="✕ キャンセル（破棄して閉じる）"
                            FontSize="13"
                            HeightRequest="40"
                            CornerRadius="8"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Dark={StaticResource DarkTextSecondary}, Light={StaticResource LightTextSecondary}}"
                            Clicked="OnCancelRecordingClicked" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ==================== コミュニティ接続メニュー オーバーレイ (DEC-024 / DEC-035) ==================== -->
        <Grid x:Name="CommunityMenuOverlay"
              IsVisible="False"
              BackgroundColor="#AA000000"
              Padding="16">
            <Border VerticalOptions="Start"
                    Margin="0,48,0,0"
                    BackgroundColor="{AppThemeBinding Dark={StaticResource DarkBgSecondary}, Light={StaticResource LightBgSecondary}}"
                    Stroke="{AppThemeBinding Dark={StaticResource DarkBorder}, Light={StaticResource LightBorder}}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="🌐 コミュニティ接続・管理"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Dark={StaticResource DarkTextPrimary}, Light={StaticResource LightTextPrimary}}"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="✕ 閉じる"
                                FontSize="13"
                                HeightRequest="34"
                                MinimumWidthRequest="0"
                                MinimumHeightRequest="0"
                                Padding="12,0"
                                CornerRadius="8"
                                BackgroundColor="{AppThemeBinding Dark={StaticResource DarkBgCard}, Light={StaticResource LightBgCard}}"
                                TextColor="{AppThemeBinding Dark={StaticResource DarkTextPrimary}, Light={StaticResource LightTextPrimary}}"
                                Clicked="OnCloseCommunityMenuClicked" />
                    </Grid>

                    <Label Text="コミュニティID または 招待URL を貼り付けて接続:"
                           FontSize="12"
                           TextColor="{AppThemeBinding Dark={StaticResource DarkTextSecondary}, Light={StaticResource LightTextSecondary}}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Border Grid.Column="0"
                                Stroke="{AppThemeBinding Dark={StaticResource DarkBorder}, Light={StaticResource LightBorder}}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{AppThemeBinding Dark={StaticResource DarkBgPrimary}, Light={StaticResource LightBgPrimary}}"
                                Padding="8,0">
                            <Entry x:Name="CommunityInputEntry"
                                   Placeholder="例: demo または https://.../?c=demo"
                                   TextColor="{AppThemeBinding Dark={StaticResource DarkTextPrimary}, Light={StaticResource LightTextPrimary}}" />
                        </Border>
                        <Button Grid.Column="1"
                                Text="接続"
                                HeightRequest="42"
                                MinimumWidthRequest="0"
                                MinimumHeightRequest="0"
                                Padding="16,0"
                                CornerRadius="8"
                                BackgroundColor="{StaticResource PrimaryBlue}"
                                TextColor="White"
                                FontAttributes="Bold"
                                Clicked="OnConnectCommunityClicked" />
                    </Grid>

                    <Label Text="接続履歴:"
                           FontSize="12"
                           TextColor="{AppThemeBinding Dark={StaticResource DarkTextSecondary}, Light={StaticResource LightTextSecondary}}" />
                    <CollectionView x:Name="CommunityHistoryView"
                                    MaximumHeightRequest="140"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button Text="{Binding .}"
                                        Margin="0,2"
                                        HeightRequest="38"
                                        MinimumHeightRequest="0"
                                        Padding="12,0"
                                        CornerRadius="8"
                                        BackgroundColor="{AppThemeBinding Dark={StaticResource DarkBgCard}, Light={StaticResource LightBgCard}}"
                                        TextColor="{AppThemeBinding Dark={StaticResource DarkTextPrimary}, Light={StaticResource LightTextPrimary}}"
                                        CommandParameter="{Binding .}"
                                        Clicked="OnHistoryCommunitySelected" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Dark={StaticResource DarkBorder}, Light={StaticResource LightBorder}}" />

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Grid.Column="0"
                                Text="🔗 招待コピー"
                                FontSize="12"
                                HeightRequest="38"
                                MinimumWidthRequest="0"
                                MinimumHeightRequest="0"
                                Padding="6,0"
                                CornerRadius="8"
                                BackgroundColor="{AppThemeBinding Dark={StaticResource DarkBgCard}, Light={StaticResource LightBgCard}}"
                                TextColor="{AppThemeBinding Dark={StaticResource DarkTextPrimary}, Light={StaticResource LightTextPrimary}}"
                                Clicked="OnCopyInviteLinkClicked" />
                        <Button Grid.Column="1"
                                Text="🔌 切断"
                                FontSize="12"
                                HeightRequest="38"
                                MinimumWidthRequest="0"
                                MinimumHeightRequest="0"
                                Padding="6,0"
                                CornerRadius="8"
                                BackgroundColor="{AppThemeBinding Dark={StaticResource DarkBgCard}, Light={StaticResource LightBgCard}}"
                                TextColor="{AppThemeBinding Dark={StaticResource DarkTextPrimary}, Light={StaticResource LightTextPrimary}}"
                                Clicked="OnDisconnectCommunityClicked" />
                        <Button Grid.Column="2"
                                Text="🚪 退会"
                                FontSize="12"
                                HeightRequest="38"
                                MinimumWidthRequest="0"
                                MinimumHeightRequest="0"
                                Padding="6,0"
                                CornerRadius="8"
                                BackgroundColor="{StaticResource DangerRed}"
                                TextColor="White"
                                Clicked="OnLeaveCommunityClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ==================== 自動再生停止パネル オーバーレイ (DEC-032) ==================== -->
        <Grid x:Name="AutoPlayStopOverlay"
              IsVisible="False"
              BackgroundColor="#BB000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAutoPlayStopOverlayTapped" />
            </Grid.GestureRecognizers>
            <Border VerticalOptions="Center"
                    HorizontalOptions="Center"
                    WidthRequest="300"
                    Padding="24"
                    Stroke="{StaticResource AccentOrange}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 18"
                    BackgroundColor="{AppThemeBinding Dark={StaticResource DarkBgSecondary}, Light={StaticResource LightBgSecondary}}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAutoPlayStopOverlayTapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Label Text="🔊 自動再生中..."
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{StaticResource AccentOrange}" />
                    <Label x:Name="AutoPlaySenderLabel"
                           Text=""
                           FontSize="16"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Dark={StaticResource DarkTextPrimary}, Light={StaticResource LightTextPrimary}}" />
                    <Label Text="画面のどこをタップしても停止します"
                           FontSize="13"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Dark={StaticResource DarkTextSecondary}, Light={StaticResource LightTextSecondary}}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ==================== 未ログイン時 ログインオーバーレイ (DEC-028) ==================== -->
        <Grid x:Name="LoginOverlay"
              IsVisible="True"
              BackgroundColor="{AppThemeBinding Dark={StaticResource DarkBgPrimary}, Light={StaticResource LightBgPrimary}}"
              Padding="24">
            <ScrollView VerticalOptions="Center">
                <Border BackgroundColor="{AppThemeBinding Dark={StaticResource DarkBgSecondary}, Light={StaticResource LightBgSecondary}}"
                        Stroke="{AppThemeBinding Dark={StaticResource DarkBorder}, Light={StaticResource LightBorder}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="24">
                    <VerticalStackLayout Spacing="16">
                        <Image Source="chatora.png"
                               WidthRequest="80"
                               HeightRequest="80"
                               HorizontalOptions="Center" />

                        <Label Text="Chatransceiver"
                               FontSize="24"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Dark={StaticResource DarkTextPrimary}, Light={StaticResource LightTextPrimary}}" />

                        <Label Text="15秒トランシーバー！文字起こし付きボイスチャット (Android Native)"
                               FontSize="13"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Dark={StaticResource DarkTextSecondary}, Light={StaticResource LightTextSecondary}}" />

                        <Button Text="🔐 Google でログイン"
                                BackgroundColor="{StaticResource PrimaryBlue}"
                                TextColor="White"
                                FontAttributes="Bold"
                                HeightRequest="48"
                                CornerRadius="10"
                                Clicked="OnGoogleLoginClicked" />

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Dark={StaticResource DarkBorder}, Light={StaticResource LightBorder}}" />

                        <Label Text="または Magic Link (メールリンク) でログイン:"
                               FontSize="12"
                               TextColor="{AppThemeBinding Dark={StaticResource DarkTextSecondary}, Light={StaticResource LightTextSecondary}}" />

                        <Entry x:Name="MagicLinkEmailEntry"
                               Placeholder="メールアドレスを入力"
                               Keyboard="Email"
                               TextColor="{AppThemeBinding Dark={StaticResource DarkTextPrimary}, Light={StaticResource LightTextPrimary}}" />

                        <Button Text="✉️ ログインリンクを送信"
                                BackgroundColor="{AppThemeBinding Dark={StaticResource DarkBgCard}, Light={StaticResource LightBgCard}}"
                                TextColor="{AppThemeBinding Dark={StaticResource DarkTextPrimary}, Light={StaticResource LightTextPrimary}}"
                                HeightRequest="44"
                                CornerRadius="10"
                                Clicked="OnMagicLinkLoginClicked" />

                        <Button Text="⚙️ Supabase接続先設定を確認・変更"
                                FontSize="12"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Dark={StaticResource DarkTextSecondary}, Light={StaticResource LightTextSecondary}}"
                                Clicked="OnSettingsClicked" />
                    </VerticalStackLayout>
                </Border>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
